<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OllamaAgent.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="OllamaAgent.Views.MainWindow"
        Title="AI Chat - Ollama"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:ChatViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="AI Chat" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <Separator Background="White" Width="1" Height="20" />
                <Button Content="Settings" 
                        Command="{Binding ToggleSettingsCommand}"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Left" />
                <Button Content="Clear Chat" 
                        Command="{Binding ClearChatCommand}"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Left" />
                <TextBlock x:Name="ThemeLabel" Text="💻" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Settings Panel -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemFillColorCautionBackground}"
                Margin="0,50,0,0"
                IsVisible="{Binding ShowSettings}">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="10">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="Base URL:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" 
                                 Text="{Binding BaseUrl, Mode=TwoWay}"
                                 Watermark="http://localhost:11434" />
                        <Button Grid.Column="2" 
                                Content="↻" 
                                Click="RefreshModels_Click"
                                Width="40" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding ModelOptions}" 
                                  SelectedItem="{Binding SelectedModelDisplay}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="API Key (Weather):" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" 
                                 Text="{Binding WeatherApiKey, Mode=TwoWay}"
                                 Watermark="API ключ для погоды" />
                    </Grid>

                    <TextBlock Text="System Prompt:" Margin="0,10,0,0" />
                    <TextBox Text="{Binding SystemPrompt, Mode=TwoWay}" 
                             AcceptsReturn="True" 
                             Height="100" 
                             Watermark="Системный промпт (инструкции для ИИ)" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Save Config" 
                                Click="SaveConfig_Click"
                                HorizontalAlignment="Right" />
                        <Button Content="Load Config" 
                                Click="LoadConfig_Click"
                                HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Chat Area -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ChatMessages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChatMessageViewModel">
                        <Border Padding="10" Margin="5" 
                                Background="{Binding BackgroundColor}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Sender}" 
                                           FontWeight="Bold"
                                           Foreground="{Binding SenderColor}" />
                                <TextBlock Text="{Binding Content}" 
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas, monospace" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2" 
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                Padding="10">
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0" 
                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Введите сообщение... (Ctrl+Enter для отправки)"
                         AcceptsReturn="True"
                         VerticalAlignment="Center"
                         KeyDown="InputTextBox_KeyDown" />
                <Button Grid.Column="1"
                        Content="Send"
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding !IsProcessing}"
                        Margin="10,0,0,0"
                        Width="100" />
            </Grid>
        </Border>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="10,35,0,0"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Grid>
</Window>
