<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OllamaAgent.ViewModels"
        xmlns:models="clr-namespace:OllamaAgent.Models"
        xmlns:controls="clr-namespace:OllamaAgent.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="OllamaAgent.Views.MainWindow"
        Title="ИИ Чат — Ollama"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:ChatViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto, *">
        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Sidebar Header -->
                <Border Grid.Row="0" Padding="10,10,10,5">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Чаты" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Content="+" 
                                Width="24" Height="24" 
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="NewChat_Click"
                                ToolTip.Tip="Новый чат" />
                    </StackPanel>
                </Border>
                
                <!-- Session List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ChatSession">
                                <Border Padding="10,5" 
                                        Background="{Binding IsSelected, Converter={StaticResource SessionSelectedConverter}}"
                                        PointerPressed="SessionItem_Click">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" 
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="13" />
                                         <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd.MM HH:mm}}'" 
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Sidebar Footer -->
                <Border Grid.Row="2" Padding="10">
                    <StackPanel Spacing="5">
                        <Button Content="🗑 Удалить чат" 
                                Click="DeleteChat_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *, Auto, Auto">
        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="ИИ Чат" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <Separator Background="White" Width="1" Height="20" />
                <Button Content="⚙ Настройки" 
                        Command="{Binding ToggleSettingsCommand}"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Left" />
                <Button Content="🗑 Очистить" 
                        Command="{Binding ClearChatCommand}"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Left" />
                <Button Content="🌙" 
                        x:Name="ThemeToggleBtn"
                        Click="ThemeToggleBtn_Click"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        Width="30" />
            </StackPanel>
        </Border>

        <!-- Settings Panel (below title bar) -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SystemFillColorCautionBackground}"
                IsVisible="{Binding ShowSettings}">
            <ScrollViewer>
                <StackPanel Margin="15" Spacing="12">
                    <!-- Base URL -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="Сервер:" VerticalAlignment="Center" Width="80" />
                        <TextBox Grid.Column="1" 
                                 Text="{Binding BaseUrl, Mode=TwoWay}"
                                 Watermark="http://localhost:11434"
                                 Margin="10,0" />
                        <Button Grid.Column="2" 
                                Content="🔄" 
                                Click="RefreshModels_Click"
                                Width="36" Height="30" />
                    </Grid>

                    <!-- Model -->
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Grid.Column="0" Text="Модель:" VerticalAlignment="Center" Width="80" />
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding ModelOptions}" 
                                  SelectedItem="{Binding SelectedModelDisplay}"
                                  Height="30"
                                  Margin="10,0"
                                  HorizontalAlignment="Right"
                                  Width="250" />
                    </Grid>

                    <!-- Weather API Key -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="API Ключ:" VerticalAlignment="Center" Width="80" />
                        <TextBox Grid.Column="1" 
                                 Text="{Binding WeatherApiKey, Mode=TwoWay}"
                                 Watermark="Ключ для погоды (weatherapi.com)"
                                 Margin="10,0" />
                    </Grid>

                    <!-- System Prompt -->
                    <TextBlock Text="Системная инструкция:" Margin="0,5,0,0" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SystemPrompt, Mode=TwoWay}" 
                             AcceptsReturn="True" 
                             Height="80" 
                             Watermark="Инструкции для ИИ..."
                             VerticalContentAlignment="Top" />

                    <!-- Thinking Mode -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="Режим:" VerticalAlignment="Center" Width="80" />
                        <CheckBox Grid.Column="1" 
                                  Content="Режим размышлений (thinking)"
                                  IsChecked="{Binding ThinkingEnabled}"
                                  Margin="10,0" />
                        <ComboBox Grid.Column="2" 
                                  ItemsSource="{Binding ThinkingDepthOptions}"
                                  SelectedItem="{Binding SelectedThinkingDepth}"
                                  Width="120"
                                  IsEnabled="{Binding ThinkingEnabled}"
                                  Margin="5,0" />
                    </Grid>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button Content="💾 Сохранить" 
                                Click="SaveConfig_Click"
                                Padding="15,5" />
                        <Button Content="📂 Загрузить" 
                                Click="LoadConfig_Click"
                                Padding="15,5" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Chat Area -->
        <Grid Grid.Row="2" RowDefinitions="*, Auto">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ChatMessages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ChatMessageViewModel">
                        <Border Padding="10" Margin="5" 
                                Background="{Binding BackgroundColor}">
                            <Panel>
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Sender}" 
                                                   FontWeight="Bold"
                                                   Foreground="{Binding SenderColor}" />
                                        
                                        <!-- Collapse/Expand button for tool results -->
                                        <Button Grid.Column="2" 
                                                Content="{Binding IsCollapsed, Converter={StaticResource CollapseToggleConverter}}"
                                                Click="CollapseToggle_Click"
                                                Width="24" Height="24"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Tag="{Binding Type}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Копировать" Click="CopyMessage_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Collapsed preview -->
                                    <TextBlock Text="{Binding PreviewText}" 
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding IsCollapsed}"
                                               FontSize="13"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    
                                    <!-- Expanded content -->
                                    <controls:MarkdownTextBlock Text="{Binding Content}" 
                                                                IsVisible="{Binding !IsCollapsed}" />
                                </StackPanel>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

            <!-- Typing Indicator -->
            <Border Grid.Row="1" 
                    Background="Transparent"
                    IsVisible="{Binding ShowTypingIndicator}"
                    Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Ассистор печатает..." 
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Input Area -->
        <Border Grid.Row="3" 
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                Padding="15">
            <StackPanel Spacing="5">
                <!-- Image Preview -->
                <Border IsVisible="{Binding HasImages}"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1">
                    <Border Padding="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📷 Прикреплённые изображения:" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding ImagePreviews}" MaxWidth="300">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <Border Width="60" Height="60" Background="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                                            <TextBlock Text="🖼" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                        <Button Content="✕" Width="16" Height="16" Padding="0" Click="RemoveImage_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Border>
                </Border>
                
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Введите сообщение... (Ctrl+Enter для отправки)"
                             AcceptsReturn="True"
                             VerticalAlignment="Center"
                             KeyDown="InputTextBox_KeyDown"
                             Height="40"
                             FontSize="14" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <Button Content="📷" 
                                Click="AttachImage_Click"
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="Прикрепить изображение" />
                        <Button Content="Отправить"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Margin="5,0,0,0"
                                Width="130"
                                Height="40"
                                FontSize="14" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                Padding="15,8">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Border>
        </Grid>
    </Grid>
</Window>
